# dcmaker configuration (copy to .env and adjust; never commit .env)

# web service
DCM_HOST=0.0.0.0
DCM_PORT=8000
# max upload size in MB (transport-layer guard)
DCM_MAX_UPLOAD_MB=32
# where converted files are written (inside the container this is a volume)
DCM_DATA_DIR=./data

# external tool overrides (default: resolve from PATH)
#DCM_FFMPEG=/usr/bin/ffmpeg
#DCM_FFPROBE=/usr/bin/ffprobe
#DCM_GIFSICLE=/usr/bin/gifsicle
#DCM_RSVG_CONVERT=/usr/bin/rsvg-convert
#DCM_PNGQUANT=/usr/bin/pngquant

# animated-SVG capture
DCM_CAPTURE_FPS=24
DCM_CAPTURE_MAX_SECONDS=15
DCM_DEFAULT_DURATION=3

# --- release automation (scripts/release.sh via the `release` compose profile) ---
# repo to publish Releases to (owner/name). Blank -> derived from git remote.
DCM_RELEASE_REPO=renhaohsuE7/dc_gif_maker
# PAT for creating GitHub Releases. SECRET — leave BLANK here; supply it only
# when cutting a release, e.g. `GITHUB_TOKEN=github_pat_xxx docker compose ...`.
# Needs fine-grained "Contents: read and write" (or classic "repo") scope.
# The long-running web service does NOT need it; keep it out of that container.
GITHUB_TOKEN=
