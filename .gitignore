# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.coverage

# env / secrets
.env

# reference clones & web-research notes are local-only (folders kept via .gitkeep)
docs/references/external_repos/*
!docs/references/external_repos/.gitkeep
docs/references/external_sites/*
!docs/references/external_sites/.gitkeep

# machine-local docs (project ancestry, handoffs — see docs/local/README.md locally)
docs/local/*
!docs/local/.gitkeep

# generated artefacts (originals/fixtures stay tracked)
samples/output/
data/

# editors / OS
.vscode/
.idea/
*.swp
.DS_Store
*:Zone.Identifier
